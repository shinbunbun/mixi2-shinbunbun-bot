{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],

  enabledManagers: ["github-actions", "dockerfile", "gomod"],

  postUpdateOptions: ["gomodTidy"],

  assignees: ["shinbunbun"],

  prConcurrentLimit: 0,
  prHourlyLimit: 0,

  minimumReleaseAge: "7 days",
  minimumReleaseAgeBehaviour: "timestamp-optional",

  packageRules: [
    {
      matchManagers: ["dockerfile"],
      pinDigests: true,
    },
    {
      matchManagers: ["dockerfile", "github-actions"],
      matchUpdateTypes: ["pin", "pinDigest", "digest"],
      automerge: true,
      automergeType: "pr",
    },
    {
      matchUpdateTypes: ["pinDigest"],
      minimumReleaseAge: null,
    },
    {
      matchManagers: ["gomod"],
      matchDepTypes: ["require"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "gomod non-major",
    },
  ],
}

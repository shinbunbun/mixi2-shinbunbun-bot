{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],

  enabledManagers: ["github-actions", "dockerfile"],

  assignees: ["shinbunbun"],

  minimumReleaseAge: "7 days",
  minimumReleaseAgeBehaviour: "timestamp-optional",

  packageRules: [
    {
      matchManagers: ["dockerfile"],
      pinDigests: true,
    },
    {
      matchManagers: ["dockerfile", "github-actions"],
      matchUpdateTypes: ["pin", "pinDigest", "digest"],
      automerge: true,
      automergeType: "pr",
    },
    {
      matchUpdateTypes: ["pinDigest"],
      minimumReleaseAge: null,
    },
  ],
}
